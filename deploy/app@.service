# /etc/systemd/system/app@.service   (one template for every app on the apps VM; from the SCGSS Backend Setup Guide, section 5)
[Unit]
Description=CCS app %i
After=network.target

[Service]
User=app_%i
WorkingDirectory=/srv/apps/%i/current
EnvironmentFile=/etc/apps/%i.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
MemoryMax=512M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/apps/%i/data

[Install]
WantedBy=multi-user.target

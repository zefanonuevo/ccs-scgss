# SCGSS settings. On the apps VM this file is /etc/apps/scgss.env (owner root, group app_scgss, mode 640). Never commit it.
PORT=3001
# Address to listen on: this apps VM's PRIVATE address (the portal VM reaches it from the VLAN). Do not use 0.0.0.0.
HOST=127.0.0.1
# The portal's public https address, no trailing slash. Requests that change data are accepted only from this address.
BASE_URL=https://ccs.dlsu.edu.ph
# Where SCGSS asks "who is signed in?". The portal server only listens on its own machine, so go through Apache on the portal host.
PORTAL_URL=https://ccs.dlsu.edu.ph
ALLOWED_DOMAIN=dlsu.edu.ph
# Student emails (juan_dela_cruz@dlsu.edu.ph: underscores, no dot) are added as Students on first sign-in. Staff emails (maria.delacruz@, with a dot)
# must be listed on the Roles screen. Set to off to require every student to be listed too.
AUTO_STUDENTS=on
# PostgreSQL (docs/DEPLOY.md step 2): one database and one login for this app.
DATABASE_URL=postgres://app_scgss:CHANGE-ME@127.0.0.1:5432/app_scgss
# Uploaded files. Must be inside the folder the service may write to.
DATA_DIR=/srv/apps/scgss/data
# Google Apps Script web app (google/Code.gs): Sheet rows, Drive files, email. Leave both empty to run without Google.
GAS_URL=
GAS_TOKEN=
